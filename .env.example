# -----------------------------
# Port Optimizer (Source)
# -----------------------------
PO_BASE_URL=https://REPLACE_WITH_YOUR_PORT_OPTIMIZER_DOMAIN
PO_API_KEY=

# If Port Optimizer requires an authenticated session, pass cookies as JSON.
# Example:
# PO_COOKIES_JSON={"session":"abc","csrf":"xyz"}
PO_COOKIES_JSON=

# -----------------------------
# Outputs
# -----------------------------
OUTPUT_DIR=outputs

# -----------------------------
# Azure SQL (Optional)
# -----------------------------
LOAD_TO_SQL=false
AZ_SQL_SERVER=yourserver.database.windows.net
AZ_SQL_DB=
AZ_SQL_USER=
AZ_SQL_PASSWORD=
AZ_SQL_DRIVER=ODBC Driver 17 for SQL Server

# -----------------------------
# Runtime
# -----------------------------
REQUEST_TIMEOUT=30
SLEEP_BETWEEN_CALLS_SEC=0.2
